.tec-occurrence-admin__views {
	display: flex;
	gap: 8px;
	margin-top: 20px;
}

.tec-occurrence-admin__heading {
	margin-bottom: 8px;
}

.tec-occurrence-admin__identity {
	color: #50575e;
	font-size: 12px;
	line-height: 1.7;
	margin-top: 6px;
}

.tec-occurrence-admin__parent,
.tec-occurrence-admin__locked {
	display: block;
}

.tec-occurrence-admin__badge {
	background: #f0f0f1;
	border: 1px solid #c3c4c7;
	border-radius: 3px;
	color: #2c3338;
	display: inline-block;
	padding: 2px 7px;
}

.tec-occurrence-admin__badge--dates {
	background: #edfaef;
	border-color: #b8dbc0;
	color: #1d5b31;
}

.tec-occurrence-admin__badge--rules {
	background: #f0edff;
	border-color: #cdc4ed;
	color: #4b3684;
}

.tec-occurrence-admin__locked {
	color: #50575e;
	font-size: 12px;
	margin-top: 6px;
}

.column-tec-schedule {
	width: 17%;
}

.column-tec-author {
	width: 8%;
}

/* Restore the filter button hidden by the legacy event list. */
.events-cal #tec-occurrence-category ~ #post-query-submit {
	display: inline-block;
}

.column-tec-start-date,
.column-tec-end-date {
	width: 15%;
}

.tec-occurrence-admin__editor {
	background: #fff;
	border: 1px solid #c3c4c7;
	margin: 16px 0;
	padding: 12px 20px;
}

.tec-occurrence-admin__editor p {
	margin: 8px 0;
}

@media screen and (max-width: 782px) {

	/* Keep filters available when WordPress hides the top navigation. */
	.events-cal .tablenav.top {
		display: flow-root;
		height: auto;
	}

	.events-cal .tablenav.top .actions:not(.bulkactions) {
		display: flex;
		flex-wrap: wrap;
		float: none;
		gap: 8px;
		margin: 12px 0;
		width: 100%;
	}
}
