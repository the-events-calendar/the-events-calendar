.tribe-editor__event-dates {
	border-top: 1px solid var(--tec-color-border-secondary, #e1e3e6);
	box-sizing: border-box;
	padding: 15px 22px;

	.tribe-editor__event-dates__title {
		font-size: 14px;
		margin: 0 0 4px;
	}

	.tribe-editor__event-dates__description,
	.tribe-editor__event-dates__notice,
	.tribe-editor__event-dates__summary {
		color: var(--tec-color-text-secondary, #5d5d5d);
		font-size: 13px;
		margin: 0 0 12px;
	}

	.tribe-editor__event-dates__description {
		margin: 12px 0 16px;
	}

	.tribe-editor__event-dates__notice:last-child,
	.tribe-editor__event-dates__summary:last-child {
		margin-bottom: 0;
	}

	/* The date input sets the row height: every other control stretches to it. */
	.tribe-editor__event-dates__row {
		align-items: stretch;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0 0 8px;
	}

	.tribe-editor__event-dates__row:last-child {
		margin-bottom: 0;
	}

	/* Match the TimePicker toggle metrics: white box, 1px border, 14px Helvetica. */
	.tribe-editor__event-dates__date {
		background-color: #fff;
		border: 1px solid #e1e3e6;
		border-radius: 2px;
		box-sizing: border-box;
		color: inherit;
		font-family: Helvetica, sans-serif;
		font-size: 14px;
		line-height: 1.5;
		padding: 5px 10px;
	}

	.tribe-editor__event-dates__row .tribe-editor__timepicker {
		display: inline-flex;
	}

	.tribe-editor__event-dates__row .tribe-editor__timepicker__toggle {
		height: 100%;
	}

	.tribe-editor__event-dates__separator {
		align-self: center;
		font-size: 14px;
	}

	.tribe-editor__event-dates__control {
		align-items: center;
		background-color: #fff;
		border: 1px solid #e1e3e6;
		border-radius: 2px;
		box-sizing: border-box;
		color: #545d66;
		cursor: pointer;
		display: inline-flex;
		justify-content: center;
		padding: 0;
		width: 40px;
	}

	.tribe-editor__event-dates__control:hover,
	.tribe-editor__event-dates__control:focus {
		border-color: #545d66;
	}

	.tribe-editor__event-dates__control svg {
		display: block;
	}
}
