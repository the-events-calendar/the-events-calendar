.tribe-editor__event-dates {
	border-top: 1px solid var(--tec-color-border-secondary, #e1e3e6);
	box-sizing: border-box;
	padding: 15px 22px;

	.tribe-editor__event-dates__title {
		font-size: 14px;
		margin: 0 0 4px;
	}

	.tribe-editor__event-dates__description,
	.tribe-editor__event-dates__notice,
	.tribe-editor__event-dates__summary {
		color: var(--tec-color-text-secondary, #5d5d5d);
		font-size: 13px;
		margin: 0 0 12px;
	}

	.tribe-editor__event-dates__notice:last-child,
	.tribe-editor__event-dates__summary:last-child {
		margin-bottom: 0;
	}

	.tribe-editor__event-dates__row {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 8px;
	}

	.tribe-editor__event-dates__date {
		border: 1px solid var(--tec-color-border-secondary, #e1e3e6);
		border-radius: 4px;
		font-size: 13px;
		padding: 4px 8px;
	}

	.tribe-editor__event-dates__separator {
		font-size: 13px;
	}

	.tribe-editor__event-dates__control {
		background: none;
		border: 1px solid var(--tec-color-border-secondary, #e1e3e6);
		border-radius: 4px;
		cursor: pointer;
		font-size: 16px;
		line-height: 1;
		min-width: 28px;
		padding: 4px 6px;
	}

	.tribe-editor__event-dates__remove {
		color: var(--tec-color-text-error, #b32d2e);
	}
}
